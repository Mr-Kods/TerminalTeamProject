# Секретный ключ приложения Flask для шифрования сессий и cookies
SECRET_KEY=your_strong_random_secret_key_here

# Ключ API OpenRouter для подключения к модели ИИ
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Название модели OpenRouter
OPENROUTER_MODEL=google/gemini-2.5-flash

# Опционально: строка подключения к БД (по умолчанию SQLite в backend/instance/database.db)
# DATABASE_URL=sqlite:///instance/database.db
