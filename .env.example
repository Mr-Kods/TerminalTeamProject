# Секретный ключ приложения Flask для шифрования сессий и cookies
SECRET_KEY=your_strong_random_secret_key_here

# Ключ API OpenRouter для подключения к модели ИИ
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Название модели OpenRouter
OPENROUTER_MODEL=google/gemini-2.5-flash

# Опционально: строка подключения к БД (по умолчанию SQLite в backend/instance/database.db)
# DATABASE_URL=sqlite:///instance/database.db

# ================= НАСТРОЙКИ ОТПРАВКИ EMAIL (SMTP) =================
# Если не заполнены, сервис работает в режиме симуляции (код выводится в консоль)

# Пример для Яндекс.Почты:
# SMTP_SERVER=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=your_login@yandex.ru
# SMTP_PASSWORD=your_yandex_app_password
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false

# Пример для Mail.ru:
# SMTP_SERVER=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=your_login@mail.ru
# SMTP_PASSWORD=your_mailru_app_password
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false

# Пример для Gmail:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_login@gmail.com
# SMTP_PASSWORD=your_google_app_password
# SMTP_USE_SSL=false
# SMTP_USE_TLS=true
